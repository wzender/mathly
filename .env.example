# Optional Supabase authentication. Leave both empty for a public local app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for class roster management.
SUPABASE_SECRET_KEY=
# Enable only after applying the additive answer-scan migration and creating its private bucket.
MATHLY_ANSWER_SCANS_ENABLED=0
TEACHER_EMAILS=
DEVELOPER_EMAILS=

# Enables photographed-problem hints and solutions.
ANTHROPIC_API_KEY=
