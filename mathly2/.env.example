# Settings for mathly2. They are read from, in order: real environment variables, mathly2/.env, then the repository's .env
# (shared with mathly1: it already holds the Supabase keys). Copy this file to mathly2/.env only to override the repository's.

# Leave the three Supabase values EMPTY for local development: the app then uses an in-memory store and a
# "dev only" sign-in that accepts any email. Set all three, or none.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Who is a teacher, a developer (every permission), or one of the first admins (they give roles to others).
# Separate addresses by commas, spaces or new lines. A class's teacher is also a teacher; everyone else in a class is a student.
TEACHER_EMAILS=
DEVELOPER_EMAILS=
ADMIN_EMAILS=

# Only for the drafting tool (mathly2/scripts/draft_examples.py). Spends API money; leave empty otherwise.
ANTHROPIC_API_KEY=
# MATH_MODEL=claude-opus-5-5
